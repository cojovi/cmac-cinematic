# Browser-safe CRM Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional local-only visual preview. Never enable in a production deployment.
VITE_ENABLE_LOCAL_PORTAL_PREVIEW=false

# Vercel Function: CRM project (server-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Function: separate, read-only Bolt-Data project (server-only)
BOLT_DATA_SUPABASE_URL=
BOLT_DATA_SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets: abuse protection
# Use a cryptographically random value with at least 32 characters.
LEAD_RATE_LIMIT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,https://cmac-cinematic.vercel.app,https://cmaccontainers.com,https://www.cmaccontainers.com

# Supabase Edge Function secrets: Google Workspace Gmail delegation only.
# Interactive employee login needs a separate Google OAuth Web application
# client ID and secret configured in the Supabase Auth dashboard.
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_PRIVATE_KEY=
GOOGLE_WORKSPACE_CLIENT_ID=

# DocuSign is deferred. Leave these empty until the Coming Soon workflow is resumed.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_WEBHOOK_HMAC_SECRET=
DOCUSIGN_SIGNER_ROLE_NAME=Customer
