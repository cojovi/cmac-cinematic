# Browser-safe CRM Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional local-only visual preview. Never enable in a production deployment.
VITE_ENABLE_LOCAL_PORTAL_PREVIEW=false

# Vercel Function: CRM project (server-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Function: separate, read-only Bolt-Data project (server-only)
BOLT_DATA_SUPABASE_URL=
BOLT_DATA_SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets: abuse protection
LEAD_RATE_LIMIT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,https://cmaccontainers.com

# Supabase Edge Function secrets: Google Workspace Gmail delegation
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_PRIVATE_KEY=
GOOGLE_WORKSPACE_CLIENT_ID=

# Supabase Edge Function secrets: DocuSign
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_WEBHOOK_HMAC_SECRET=
DOCUSIGN_SIGNER_ROLE_NAME=Customer
